{
  "$id": "https://tangled.protocol/schemas/pub.tangled.publication.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pub.tangled.publication",
  "description": "An explicitly selected public copy of plain content, independent of the originating application. Source records and their private metadata are not references in this body. Unknown extension fields are allowed and preserved by metadata updates.",
  "type": "object",
  "required": ["version", "title", "description", "items", "html", "rss"],
  "properties": {
    "version": {"const": 1},
    "title": {"type": "string", "maxLength": 4096},
    "description": {"type": "string"},
    "siteUrl": {"type": "string", "pattern": "^https?://", "description": "Explicit HTTP(S) deployment URL; its presence does not claim that deployment occurred."},
    "html": {"type": "string", "description": "Content-addressed generated escaped HTML blob CID."},
    "rss": {"type": "string", "description": "Content-addressed generated RSS XML blob CID."},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "required": ["title", "text", "description"],
        "properties": {
          "title": {"type": "string", "maxLength": 4096},
          "text": {"type": "string", "description": "Plain literal text, never HTML."},
          "description": {"type": "string", "description": "Plain literal text, never HTML."},
          "link": {"type": "string", "pattern": "^https?://"},
          "attachments": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": ["name", "blob", "path", "mime", "size"],
              "properties": {
                "name": {"type": "string", "maxLength": 4096},
                "blob": {"type": "string", "description": "Original blob CID, present only after explicit individual selection."},
                "path": {"type": "string", "pattern": "^attachments/[0-9a-f]{64}\\.bin$", "description": "Safe relative path in a static export."},
                "mime": {"const": "application/octet-stream"},
                "size": {"type": "integer", "minimum": 0, "maximum": 16777216}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
