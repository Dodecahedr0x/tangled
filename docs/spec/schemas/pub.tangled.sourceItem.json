{
  "$id": "https://tangled.protocol/schemas/pub.tangled.sourceItem.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pub.tangled.sourceItem",
  "description": "Private projection signed by the local owner, not the native sender. Identity is scoped to source/account/kind/conversation/id; originals and native author data stay in imported/revisions.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "identity",
    "imported",
    "revisions",
    "currentRevision",
    "deleted"
  ],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source",
        "account",
        "kind",
        "conversation",
        "id"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "account": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "conversation": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "imported": {
      "$ref": "#/$defs/imported"
    },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "imported",
          "originalBlob"
        ],
        "properties": {
          "imported": {
            "$ref": "#/$defs/imported"
          },
          "originalBlob": {
            "type": "string",
            "minLength": 1
          },
          "sourceOriginalBlob": {
            "type": "string",
            "minLength": 1
          },
          "sourceOriginalMime": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "currentRevision": {
      "type": "integer",
      "minimum": 0
    },
    "deleted": {
      "type": "boolean"
    }
  },
  "$defs": {
    "imported": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "source",
        "account",
        "object"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "account": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string"
        },
        "revisionOrder": {
          "type": "integer",
          "minimum": 0
        },
        "object": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "id",
            "kind"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "conversation": {
              "type": [
                "string",
                "null"
              ]
            },
            "sender": {
              "type": [
                "string",
                "null"
              ]
            },
            "timestamp": {
              "type": [
                "string",
                "null"
              ]
            },
            "text": {
              "type": [
                "string",
                "null"
              ]
            },
            "attachments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "data": {},
            "deleted": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
