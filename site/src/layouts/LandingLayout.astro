---
/* THESIS: Landing as a vertical rise through protocol courses; refuses gradient-card SaaS heroes.
   OWN-WORLD: Slate #12141a, copper #c47a4a, Source Serif 4 display, Fira chrome, hairline plates.
   STORY: Visitor understands the substrate, sees the apps, enters the spec.
   FIRST VIEWPORT: Full-bleed type, kicker tangled::protocol, Read the spec / GitHub, no cards.
   FORM: Assigned courses (seed dea6db17), Comp B plates, rustdocs × Mintlify identity. */
import "../styles/global.css";
import Chrome from "../components/Chrome.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Tangled",
  description = "A content-network protocol: Solana identity, signed Merkle repositories, capability authorization.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Source+Code+Pro:wght@400;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="is-landing">
    <Chrome>
      <main class="land" id="content">
        <slot />
      </main>
    </Chrome>
  </body>
</html>
