---
/* THESIS: Funnel mouth in plain speech; refuses a spec dump as the first page.
   OWN-WORLD: Slate #12141a, copper #c47a4a, Source Serif 4 display, Fira chrome, hairline plates.
   STORY: Stranger understands hosting, sees three apps, opens Docs.
   FIRST VIEWPORT: One kicker, monumental serif, How it works / GitHub.
   FORM: Vertical courses, Comp B plates, rustdocs × Mintlify identity at larger type. */
import "../styles/global.css";
import Chrome from "../components/Chrome.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Tangled",
  description = "Tangled is a way to keep your posts, messages, and name on a computer you control. A protocol, not a product you join.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Source+Code+Pro:wght@400;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="is-landing">
    <Chrome>
      <main class="land" id="content">
        <slot />
      </main>
    </Chrome>
  </body>
</html>
