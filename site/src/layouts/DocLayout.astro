---
/* THESIS: Protocol documentation as a type-indexed instrument; refuses centered SaaS-docs heroes.
   OWN-WORLD: Slate, copper, Fira Sans / Source Serif 4 / Source Code Pro, hairline borders.
   STORY: Implementer finds claim, type, method, vector in one shell.
   FIRST VIEWPORT: Dark chrome, 272px module tree, docs as a section of the site.
   FORM: rustdocs × Mintlify canon, restrained, dark-first. */
import "../styles/global.css";
import Chrome from "../components/Chrome.astro";
import { specNav, toolNav, sitePath, withBase } from "../data/nav";

interface Props {
  title: string;
  description?: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, description = "Tangled protocol specification", headings = [] } = Astro.props;
const path = sitePath(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · Tangled</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fira+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Source+Code+Pro:wght@400;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />
    <link href={withBase("/pagefind/pagefind-ui.css")} rel="stylesheet" />
  </head>
  <body>
    <Chrome showSearch showMenu>
      <div class="shell">
        <nav class="sidebar" id="sidebar" aria-label="Specification">
          <div class="mod">site::docs</div>
          <a class:list={["nav-link", { active: path === "/docs" }]} href={withBase("/docs")}>Overview</a>
          {
            specNav.map((g) => (
              <>
                <div class="mod">{g.module}</div>
                {g.items.map((i) => (
                  <a class:list={["nav-link", { active: path === i.href }]} href={withBase(i.href)}>
                    {i.label}
                  </a>
                ))}
              </>
            ))
          }
          <div class="mod">spec::tools</div>
          {
            toolNav.map((i) => (
              <a class:list={["nav-link", { active: path === i.href || path.startsWith(i.href + "/") }]} href={withBase(i.href)}>
                {i.label}
              </a>
            ))
          }
        </nav>
        <div class="main">
          <main class="prose" id="content" data-pagefind-body>
            <slot />
          </main>
          {
            headings.length > 0 && (
              <aside class="toc" aria-label="On this page">
                <h2>On this page</h2>
                {headings
                  .filter((h) => h.depth === 2 || h.depth === 3)
                  .map((h) => (
                    <a class={`depth-${h.depth}`} href={`#${h.slug}`}>
                      {h.text}
                    </a>
                  ))}
              </aside>
            )
          }
        </div>
      </div>
    </Chrome>
  </body>
</html>
