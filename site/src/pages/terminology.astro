---
import DocLayout from "../layouts/DocLayout.astro";
import { getCollection, render } from "astro:content";

const chapters = await getCollection("spec");
const entry = chapters.find((c) => c.data.slug === "terminology");
if (!entry) throw new Error("terminology chapter missing");
const { Content, headings } = await render(entry);
---

<DocLayout title="Terminology" description="Every acronym and glossary noun in Tangled" headings={headings}>
  <Content />
</DocLayout>
