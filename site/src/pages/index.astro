---
/* THESIS: Funnel mouth in plain speech; refuses rustdoc kickers and a spec dump as the first page.
   OWN-WORLD: Slate, copper, Source Serif display, Fira chrome, hairline app rows.
   STORY: A stranger gets what Tangled is, sees three apps, opens Docs.
   FIRST VIEWPORT: One serif line, one paragraph, How it works / GitHub. One copper kicker.
   FORM: Vertical courses, Comp B plates, same world as docs — larger type, fewer words. */
import LandingLayout from "../layouts/LandingLayout.astro";
import { githubUrl, withBase } from "../data/nav";

const providerUrl = import.meta.env.PUBLIC_PROVIDER_URL as string | undefined;

const apps = [
  {
    name: "Reed",
    href: `${githubUrl}/tree/main/apps/reed`,
    copy: "Public posts, profiles, and follows. A timeline you host.",
  },
  {
    name: "Loomed",
    href: `${githubUrl}/tree/main/apps/loomed`,
    copy: "Private groups. Messages for people you already trust.",
  },
  {
    name: "Weft",
    href: `${githubUrl}/tree/main/apps/weft`,
    copy: "A map of the network. Counts, connections, lookup. It does not post.",
  },
];
---

<LandingLayout>
  <section class="land-hero">
    <p class="land-kicker">{providerUrl ? "A hosted knot" : "A protocol, not a product"}</p>
    <h1>{providerUrl ? "Create an account." : "Host it yourself."}</h1>
    <p class="land-lead">
      {
        providerUrl
          ? "You don’t run a server. The hosted knot keeps your posts in a signed repository. The documents still explain how to run your own."
          : "Tangled is a way to keep your posts, messages, and name on a computer you control. Apps sit on top. This site explains how — there isn’t a public Tangled to join yet."
      }
    </p>
    <div class="land-cta">
      {
        providerUrl ? (
          <a class="btn-primary" href={providerUrl}>
            Create an account
          </a>
        ) : (
          <a class="btn-primary" href={withBase("/guides")}>
            How it works
          </a>
        )
      }
      <a class="btn-ghost" href={providerUrl ? withBase("/guides") : githubUrl} rel={providerUrl ? undefined : "noopener noreferrer"}>
        {providerUrl ? "How it works" : "GitHub"}
      </a>
    </div>
    <p class="land-aside">
      {
        providerUrl
          ? "The host holds the account key and says so. No user count. The documents are still the contract."
          : "No sign-up. No hosted feed. The documents are the release."
      }
    </p>
  </section>

  <section class="land-course" aria-labelledby="why">
    <h2 id="why">You shouldn’t need a company to keep a conversation.</h2>
    <p>
      Most networks store your words on someone else’s servers. Tangled is built so
      <strong>you</strong> run the host. Friends copy your updates. If that machine goes
      away, the signed history can live on another one — the host was never the authority.
    </p>
  </section>

  <section class="land-course" aria-labelledby="apps">
    <h2 id="apps">Three apps in this repository.</h2>
    <p>
      They are clients of one shared store, not a suite you subscribe to. None of them
      are a live service on this site.
    </p>
    <ul class="land-apps">
      {
        apps.map((app) => (
          <li>
            <a href={app.href} rel="noopener noreferrer">
              <span class="name">{app.name}</span>
              <span>{app.copy}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="land-course land-close" aria-labelledby="next">
    <h2 id="next">Start here, then go deeper.</h2>
    <p>
      <a href={withBase("/guides")}>Guides</a> introduce Tangled and help you get started.
      <a href={withBase("/docs")}>Docs</a> explain each feature in detail.
      <a href={withBase("/spec/abstract")}>Specs</a> define the formal protocol:
      types, HTTP methods, and conformance requirements.
    </p>
    <div class="land-cta">
      <a class="btn-primary" href={withBase("/guides")}>Read the guides</a>
      <a class="btn-ghost" href={withBase("/docs")}>Explore the docs</a>
      <a class="btn-ghost" href={withBase("/spec/abstract")}>Open the spec</a>
    </div>
  </section>
</LandingLayout>
