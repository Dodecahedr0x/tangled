---
import DocLayout from "../../layouts/DocLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const chapters = await getCollection("spec");
  return chapters.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocLayout title={entry.data.title} description={`Tangled specification: ${entry.data.title}`} headings={headings}>
  <p style="font-family: var(--font-mono); font-size: 12px; color: var(--text-faint); margin: 0 0 8px;">
    spec::{entry.data.slug} · order {entry.data.order}
  </p>
  <Content />
</DocLayout>
