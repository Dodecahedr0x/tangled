---
import DocLayout from "../../layouts/DocLayout.astro";
import { readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";

const yaml = readFileSync(fileURLToPath(new URL("../../../../spec/http/openapi.yaml", import.meta.url)), "utf8");
---

<DocLayout title="OpenAPI" description="Tangled Knot HTTP API (OpenAPI 3.1)">
  <h1>OpenAPI</h1>
  <p>
    Canonical machine-readable HTTP API from <code>spec/http/openapi.yaml</code>.
    Copied to <a href="/openapi.yaml">/openapi.yaml</a> on preview and build.
    Human-readable notes: <a href="/reference/http">HTTP reference</a>,
    <a href="/spec/http-api">HTTP API</a>.
  </p>
  <h2 id="source">Source</h2>
  <pre><code>{yaml}</code></pre>
</DocLayout>
