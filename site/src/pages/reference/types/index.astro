---
import DocLayout from "../../../layouts/DocLayout.astro";
import { types } from "../../../data/types";
import { withBase } from "../../../data/nav";
---

<DocLayout title="Type index" description="Rustdoc-style index of Tangled types">
  <h1>Type index</h1>
  <p>Reading aids from <code>docs/reference/types.json</code>. Signatures are rustdoc-shaped; the specification's CDDL and schemas define the normative encoding.</p>
  <table>
    <thead>
      <tr><th>Type</th><th>Module</th><th></th></tr>
    </thead>
    <tbody>
      {
        types.map((t) => (
          <tr>
            <td><a href={withBase(t.href)}><code>{t.name}</code></a></td>
            <td><code>{t.module}</code></td>
            <td>{t.summary}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</DocLayout>
